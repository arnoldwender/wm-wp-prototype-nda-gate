msgstr "Pliiats"

#: includes/class-nda-evidence.php:179
msgid "Touch"
msgstr "Puuteekraan"

#: includes/class-nda-evidence.php:180 includes/class-nda-evidence.php:193
msgid "Tastatur"
msgstr "Klaviatuur"

#: includes/class-nda-evidence.php:181
msgid "nicht erkannt"
msgstr "tuvastamata"

#: includes/class-nda-evidence.php:185
msgid "Eingabegerät"
msgstr "Sisendseade"

#: includes/class-nda-evidence.php:191
msgid "Bestätigt per"
