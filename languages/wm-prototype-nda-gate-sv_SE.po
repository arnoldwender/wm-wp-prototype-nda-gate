msgstr ""
"Kryssruta vid inloggning, admin-, frontend- och REST-spärr, projektnamn och "
"demodata."

#: includes/class-nda-admin.php:931
msgid "Einstellungen erfolgreich gespeichert."
msgstr "Inställningarna har sparats."

