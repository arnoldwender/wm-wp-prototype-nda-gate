msgid "Zeigegerät"
msgstr "Dispozitiv de indicare"

#: includes/class-nda-evidence.php:200
msgid "Zeit im Dialog"
msgstr "Timp în fereastră"

#: includes/class-nda-evidence.php:207
msgid "Zwischen Häkchen und Bestätigung"
msgstr "Între bifare și confirmare"

#: includes/class-nda-evidence.php:214
msgid "Gelesener Anteil des Textfensters"
